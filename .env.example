# MONGODB_URI: MongoDB connection string (e.g. mongodb+srv://username:password@cluster.mongodb.net/veyra?retryWrites=true&w=majority)
# If omitted or not reachable in sandbox, Veyra gracefully uses embedded persistent JSON storage.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/veyra?retryWrites=true&w=majority"

# JWT_SECRET: Secret key for signing JSON Web Tokens for authentication.
JWT_SECRET="veyra_production_jwt_secret_key_change_in_production_92837482"

# PORT: Server port (defaults to 3000)
PORT=3000

# NODE_ENV: production or development
NODE_ENV="development"
